{
  "manifest_version": 3,
  "name": "Pris Bridge — DNA1",
  "version": "2.1.1",
  "description": "Verbindet PRIS mit offenen Browser-KI-Tabs. Sendet Fragen parallel an unterstützte KIs; der PRIS-Rückkanal bleibt ChatGPT.",
  "key": "",
  "permissions": [
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://claude.com/*",
    "https://kimi.com/*",
    "https://www.kimi.com/*",
    "https://gemini.google.com/*",
    "https://grok.com/*",
    "https://x.com/*",
    "https://www.perplexity.ai/*",
    "https://perplexity.ai/*",
    "https://chat.deepseek.com/*",
    "https://deepseek.com/*",
    "https://chat.mistral.ai/*",
    "https://qwen.ai/*",
    "https://chat.qwen.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://claude.com/*",
        "https://chatgpt.com/*",
        "https://www.chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://kimi.com/*",
        "https://www.kimi.com/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://x.com/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*",
        "https://chat.deepseek.com/*",
        "https://deepseek.com/*",
        "https://chat.mistral.ai/*",
        "https://qwen.ai/*",
        "https://chat.qwen.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Pris Bridge: Status dieses Tabs"
  },
  "externally_connectable": {
    "matches": [
      "https://127.0.0.1:3000/*",
      "http://127.0.0.1:3000/*",
      "https://localhost:3000/*",
      "http://localhost:3000/*",
      "http://localhost:5173/*",
      "https://localhost:5173/*",
      "http://127.0.0.1:5173/*",
      "https://127.0.0.1:5173/*",
      "https://dna-legal.example/*"
    ]
  }
}
